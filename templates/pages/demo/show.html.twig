{% extends 'layouts/app.html.twig' %}

{% block title %}Demo — {{ item.name }}{% endblock %}
{% block page_title %}{{ item.name }}{% endblock %}
{% block page_actions %}
    {# Primary action visible, secondary and destructive actions in the ⋯ menu #}
    <twig:Button variant="primary" size="sm" href="{{ path('app_demo_edit', {id: item.id}) }}">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Edit
    </twig:Button>
    <twig:ActionMenu label="More actions for {{ item.name }}">
        <twig:ActionMenu:Item href="{{ path('app_demo_new') }}">Duplicate</twig:ActionMenu:Item>
        <twig:ActionMenu:Divider />
        <twig:ActionMenu:Item variant="danger" data-modal-trigger="confirm-delete">Delete…</twig:ActionMenu:Item>
    </twig:ActionMenu>
{% endblock %}

{% block content %}
<div class="max-w-3xl">
    <twig:Card>
        <twig:DescriptionList columns="2">
            <twig:DescriptionList:Item label="Name" value="{{ item.name }}" />
            <twig:DescriptionList:Item label="Category" value="{{ item.category }}" />
            <twig:DescriptionList:Item label="Status">
                <twig:Badge variant="{{ item.status }}">{{ item.statusLabel }}</twig:Badge>
            </twig:DescriptionList:Item>
            <twig:DescriptionList:Item label="Priority" value="{{ item.priority }}" />
            <twig:DescriptionList:Item label="Date" value="{{ item.date|format_date('long') }}" numeric />
            <twig:DescriptionList:Item label="Color">
                <span class="flex items-center gap-2">
                    <span class="inline-block w-5 h-5 rounded border border-border" style="background-color: {{ item.color }}" aria-hidden="true"></span>
                    {{ item.color }}
                </span>
            </twig:DescriptionList:Item>
            <twig:DescriptionList:Item label="Owner" />
            <twig:DescriptionList:Item label="Description" span="2" value="An empty value is displayed as a dash, never as a blank." />
        </twig:DescriptionList>
    </twig:Card>

    <div class="mt-4">
        <twig:Button variant="secondary" href="{{ path('app_demo_index') }}">&larr; Back to list</twig:Button>
    </div>
</div>

<twig:ConfirmDialog id="confirm-delete" title="Delete “{{ item.name }}”?"
    action="{{ path('app_demo_delete', {id: item.id}) }}" csrfTokenId="delete-item-{{ item.id }}"
    confirmLabel="Delete the item">
    <p>This item will be permanently removed. This action cannot be undone.</p>
</twig:ConfirmDialog>
{% endblock %}
