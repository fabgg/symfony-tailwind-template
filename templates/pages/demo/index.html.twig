{% extends 'layouts/app.html.twig' %}

{% block title %}Demo — Listing{% endblock %}
{% block page_title %}Demo{% endblock %}
{% block page_actions %}
    <twig:Button variant="primary" size="sm" href="{{ path('app_demo_new') }}">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v16m8-8H4"/></svg>
        Create
    </twig:Button>
{% endblock %}

{% block content %}
{# Search: GET form, state kept in the URL (shareable, Back button works). Sort and page size are preserved. #}
<form method="get" action="{{ path('app_demo_index') }}" class="mb-4 flex items-center gap-2" role="search" data-controller="autosubmit">
    {% for name in ['sort', 'direction', 'limit'] %}
        {% if app.request.query.has(name) %}<input type="hidden" name="{{ name }}" value="{{ app.request.query.get(name) }}">{% endif %}
    {% endfor %}
    <label for="demo-search" class="sr-only">Search</label>
    <input id="demo-search" type="search" name="q" value="{{ search }}" placeholder="Search by name or category…"
           autocomplete="off" data-action="input->autosubmit#debouncedSubmit"
           class="w-full max-w-sm rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
</form>

<twig:Card>
    <twig:Table>
        <thead>
            <tr>
                <twig:Table:SortableHeader :pagination="pagination" label="Name" field="[name]" />
                <twig:Table:SortableHeader :pagination="pagination" label="Category" field="[category]" />
                <th scope="col" class="px-4 py-3 text-left text-xs uppercase tracking-wide text-text-secondary">Status</th>
                <th scope="col" class="px-4 py-3 text-left text-xs uppercase tracking-wide text-text-secondary">Priority</th>
                <twig:Table:SortableHeader :pagination="pagination" label="Date" field="[date]" />
                <th scope="col" class="px-4 py-3 text-left text-xs uppercase tracking-wide text-text-secondary">Color</th>
                <th scope="col" class="px-4 py-3 text-right text-xs uppercase tracking-wide text-text-secondary">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            {% for item in pagination %}
            <tr class="hover:bg-surface-hover transition-colors">
                <td class="px-4 py-3 text-sm font-medium text-text-primary">
                    <a href="{{ path('app_demo_show', {id: item.id}) }}" class="hover:text-primary-600 transition-colors">{{ item.name }}</a>
                </td>
                <td class="px-4 py-3 text-sm text-text-secondary">{{ item.category }}</td>
                <td class="px-4 py-3"><twig:Badge variant="{{ item.status }}">{{ item.statusLabel }}</twig:Badge></td>
                <td class="px-4 py-3 text-sm text-text-secondary">{{ item.priority }}</td>
                <td class="px-4 py-3 text-sm text-text-secondary tabular-nums">{{ item.date|format_date('medium') }}</td>
                <td class="px-4 py-3">
                    <span class="inline-block w-5 h-5 rounded border border-border" style="background-color: {{ item.color }}" aria-hidden="true"></span>
                    <span class="sr-only">{{ item.color }}</span>
                </td>
                <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-1">
                        <twig:Button variant="ghost" size="xs" href="{{ path('app_demo_show', {id: item.id}) }}">View</twig:Button>
                        <twig:Button variant="ghost" size="xs" href="{{ path('app_demo_edit', {id: item.id}) }}">Edit</twig:Button>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="px-4 py-10 text-center text-sm text-text-secondary">
                    No item matches “{{ search }}”. <a href="{{ path('app_demo_index') }}" class="text-primary-600 hover:underline">Clear the search</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </twig:Table>
</twig:Card>

{{ knp_pagination_render(pagination) }}
{% endblock %}
