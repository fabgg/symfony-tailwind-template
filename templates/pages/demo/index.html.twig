{% extends 'layouts/app.html.twig' %}

{% block title %}Demo — Listing{% endblock %}
{% block page_title %}Demo{% endblock %}
{% block page_actions %}
    <twig:Button variant="primary" size="sm" href="{{ path('app_demo_new') }}">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v16m8-8H4"/></svg>
        Create
    </twig:Button>
{% endblock %}

{% block content %}
{# Search + filters: GET form, the whole state stays in the URL (shareable, Back button works). #}
{# View filter: SegmentedControl (links, state in the URL) #}
{% set _items = [{label: 'All', href: path('app_demo_index', app.request.query.all|filter((v, k) => k != 'status' and k != 'page')), active: status == ''}] %}
{% for name, count in statusCounts %}
    {% set _items = _items|merge([{label: name, href: path('app_demo_index', app.request.query.all|filter((v, k) => k != 'page')|merge({status: name})), active: status == name, count: count}]) %}
{% endfor %}
<twig:SegmentedControl label="Status" :items="_items" class="mb-3" />

<twig:ListToolbar :activeFilters="category ? [{param: 'category', label: 'Category: ' ~ category}] : []" :keep="['sort', 'direction', 'limit', 'status']">
    <twig:SearchInput value="{{ search }}" placeholder="Search by name or category…" />
    <twig:block name="filters">
        <label for="filter-category" class="sr-only">Category</label>
        <select id="filter-category" name="category" data-action="autosubmit#submit"
                class="h-9 rounded-lg border border-border bg-surface px-2 text-sm text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500">
            <option value="">All categories</option>
            {% for c in categories %}
                <option value="{{ c }}" {{ c == category ? 'selected' }}>{{ c }}</option>
            {% endfor %}
        </select>
    </twig:block>
</twig:ListToolbar>

<twig:Card :padding="false">
    {% if pagination.totalItemCount == 0 %}
        <twig:EmptyState title="No item matches your search" icon="search"
                         description="Check the spelling or remove a filter.">
            <twig:Button variant="secondary" size="sm" href="{{ path('app_demo_index') }}">Clear search and filters</twig:Button>
        </twig:EmptyState>
    {% else %}
    <twig:Table>
        <thead>
            <tr>
                <twig:Table:SortableHeader :pagination="pagination" label="Name" field="[name]" />
                <twig:Table:SortableHeader :pagination="pagination" label="Category" field="[category]" />
                <th scope="col" class="px-4 py-3 text-left text-xs uppercase tracking-wide text-text-secondary">Status</th>
                <th scope="col" class="px-4 py-3 text-left text-xs uppercase tracking-wide text-text-secondary">Priority</th>
                <twig:Table:SortableHeader :pagination="pagination" label="Date" field="[date]" />
                <th scope="col" class="px-4 py-3 text-right text-xs uppercase tracking-wide text-text-secondary"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-border">
            {% for item in pagination %}
            <tr class="hover:bg-surface-hover transition-colors">
                <td class="px-4 py-3 text-sm font-medium text-text-primary">
                    <a href="{{ path('app_demo_show', {id: item.id}) }}" class="hover:text-primary-600 transition-colors">{{ item.name }}</a>
                </td>
                <td class="px-4 py-3 text-sm text-text-secondary">{{ item.category }}</td>
                <td class="px-4 py-3"><twig:Badge variant="{{ item.status }}">{{ item.statusLabel }}</twig:Badge></td>
                <td class="px-4 py-3 text-sm text-text-secondary">{{ item.priority }}</td>
                <td class="px-4 py-3 text-sm text-text-secondary tabular-nums">{{ item.date|format_date('medium') }}</td>
                <td class="px-4 py-2 text-right">
                    <twig:ActionMenu label="Actions for {{ item.name }}">
                        <twig:ActionMenu:Item href="{{ path('app_demo_show', {id: item.id}) }}">View</twig:ActionMenu:Item>
                        <twig:ActionMenu:Item href="{{ path('app_demo_edit', {id: item.id}) }}">Edit</twig:ActionMenu:Item>
                    </twig:ActionMenu>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </twig:Table>
    {% endif %}
</twig:Card>

{{ knp_pagination_render(pagination) }}
{% endblock %}
