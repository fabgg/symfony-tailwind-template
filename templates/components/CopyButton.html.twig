{# Copies `value` to the clipboard and announces `message` (aria-live). <twig:CopyButton value="812345678" label="Copy the SIREN" message="SIREN copied." /> #}
{% props value, label, message = null %}
<button type="button" data-controller="copy" data-copy-value-value="{{ value }}" data-copy-message-value="{{ message ?? label }}" data-action="copy#copy"
        {{ attributes.defaults({class: 'rounded p-0.5 text-text-muted hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500'}) }}
        aria-label="{{ label }}" title="{{ label }}">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
    <span class="sr-only" aria-live="polite" data-copy-target="status"></span>
</button>
