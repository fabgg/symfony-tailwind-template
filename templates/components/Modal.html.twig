{#
    Accessible modal dialog.
    Open it with any element carrying data-modal-trigger="<id>", close with Escape, the × button,
    a click on the overlay or an element with data-action="modal#close".
    Focus is trapped inside while open and returned to the trigger on close.
#}
{% props id, title, size = 'md' %}

{% set sizes = {
    sm: 'max-w-sm',
    md: 'max-w-lg',
    lg: 'max-w-3xl',
    xl: 'max-w-5xl',
} %}

<div id="{{ id }}"
     data-controller="modal"
     data-modal-open-value="false"
     class="hidden fixed inset-0 z-50 overflow-y-auto overscroll-contain">
    {# Overlay + Dialog wrapper #}
    <div data-action="click->modal#closeOnOverlay" class="fixed inset-0 bg-black/50 flex items-center justify-center p-4">
        <div class="relative w-full {{ sizes[size] ?? sizes.md }} max-h-[calc(100vh-2rem)] flex flex-col bg-surface rounded-lg shadow-xl border border-border"
             role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title"
             data-modal-target="dialog">
            {# Header #}
            <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-border">
                <h2 id="{{ id }}-title" class="text-lg font-semibold text-text-primary text-balance">{{ title }}</h2>
                <button type="button" data-action="modal#close"
                        class="rounded p-1 text-text-muted hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 transition-colors"
                        aria-label="{{ 'modal.close'|trans }}">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            {# Body + optional Footer via Modal:Body / Modal:Footer sub-components #}
            <div class="overflow-y-auto">
                {% block content %}{% endblock %}
            </div>
        </div>
    </div>
</div>
